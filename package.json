{
  "name": "rocksaurus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --mode public",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run lint:boundaries && npm run lint:dead-code && npm run lint:audit && npm run format:check && npm test",
    "lint:boundaries": "depcruise src",
    "lint:dead-code": "fallow dead-code",
    "lint:audit": "fallow audit --base origin/main",
    "test:e2e": "vite build && playwright test",
    "skills": "npx -y skills@1.7.0 experimental_install"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@playwright/test": "^1.64.0",
    "@swc/core": "^1.16.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.5.0",
    "fallow": "3.32.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "description": "Rocksaurus Dino Studio — 3D dinosaur band shorts made with React, Three.js and Web Audio.",
  "engines": {
    "node": ">=24"
  }
}
